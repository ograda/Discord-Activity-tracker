<activity-tracker>
    <discord-application-id>YOUR_NUMERIC_APPLICATION_ID</discord-application-id>
    <poll-seconds>5</poll-seconds>

    <links>
        <repository>https://github.com/ograda/Discord-Activity-tracker</repository>
        <button>
            <label>GitHub</label>
            <url>https://github.com/ograda/Discord-Activity-tracker</url>
        </button>
        <button>
            <label>My Website</label>
            <url>https://example.com</url>
        </button>
    </links>

    <activity>
        <name>World of Warcraft</name>
        <display-name>WoW</display-name>
        <verb>playing</verb>
        <image>wow</image>
        <!-- Optional manual small-icon tooltip; no automatic metadata discovery. -->
        <!-- <tracker-status>Guerreiro · Level 84</tracker-status> -->
        <!-- Separate game processes represent logical instances. -->
        <instance-count-mode>processes</instance-count-mode>
        <windows-process>Wow.exe</windows-process>
        <windows-process>WowClassic.exe</windows-process>
    </activity>

    <activity>
        <name>Visual Studio Code</name>
        <display-name>VS Code</display-name>
        <verb>coding</verb>
        <image>vscode</image>
        <windows-process>Code.exe</windows-process>
    </activity>

    <activity>
        <name>Google Chrome</name>
        <!-- Windows is the default if instance-count-mode is omitted. -->
        <instance-count-mode>windows</instance-count-mode>
        <verb>browsing</verb>
        <image>chrome</image>
        <windows-process>chrome.exe</windows-process>
    </activity>
</activity-tracker>
