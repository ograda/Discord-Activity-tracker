<activity-tracker>
    <discord-application-id>YOUR_NUMERIC_APPLICATION_ID</discord-application-id>
    <poll-seconds>5</poll-seconds>

    <links>
        <repository>https://github.com/ograda/Discord-Activity-tracker</repository>
        <button>
            <label>GitHub</label>
            <url>https://github.com/ograda/Discord-Activity-tracker</url>
        </button>
        <button>
            <label>My Website</label>
            <url>https://example.com</url>
        </button>
    </links>

    <activity>
        <name>World of Warcraft</name>
        <display-name>WoW</display-name>
        <verb>Playing</verb>
        <image>wow</image>
        <windows-process>Wow.exe</windows-process>
    </activity>

    <activity>
        <name>Visual Studio Code</name>
        <display-name>VS Code</display-name>
        <verb>Coding with</verb>
        <image>vscode</image>
        <windows-process>Code.exe</windows-process>
    </activity>

    <activity>
        <name>Chrome</name>
        <verb>Browsing with</verb>
        <image>chrome</image>
        <windows-process>chrome.exe</windows-process>
    </activity>
</activity-tracker>
